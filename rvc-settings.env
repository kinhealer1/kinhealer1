# Settings for the "RVC voice conversion" GitHub Action.
# Edit these, commit, and the next run uses them.

# Model used for files placed directly in input/ (filename in models/, without .pth).
# Files in input/<model-name>/ use that model instead.
# Leave empty to use the only .pth in models/ (if there is exactly one).
DEFAULT_MODEL=""

# Pitch shift in semitones. Male -> female voice: 12, female -> male: -12, same: 0.
PITCH=0

# How strongly to use the .index file (0-1). Higher = closer to the model's timbre.
INDEX_RATE=0.75

# Protect breaths/consonants from artifacts (0-0.5). Lower = more protection.
PROTECT=0.33

# Volume envelope mix (0-1). 1 = keep output loudness, lower = follow input loudness.
RMS_MIX_RATE=0

# Pitch extraction: rmvpe (best quality) or pm (faster, lower quality).
F0_METHOD=rmvpe

# Output format: wav, flac, mp3 or m4a.
OUTPUT_FORMAT=wav
